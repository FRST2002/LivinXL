# Resend (e-mailnotificaties bij offerte- en contactaanvragen)
# Zonder RESEND_KEY_LIVINXL worden er simpelweg geen e-mails verstuurd; de formulieren
# blijven wel gewoon werken.
# Let op: deze heet bewust niet "RESEND_API_KEY" — die naam bleef op het Vercel-project
# hangen (verdween/reset telkens), een andere naam werkte direct wel.
RESEND_KEY_LIVINXL=
# Optioneel: overschrijf de standaard afzender/ontvanger
RESEND_FROM_EMAIL="LivinXL Website <noreply@livinxl.nl>"
RESEND_TO_EMAIL=info@livinxl.nl

# Database (opslag van offerteaanvragen voor /admin)
# Wordt automatisch gezet door de Neon/Vercel Postgres-integratie op Vercel; lokaal haal je
# 'm op via het Neon-dashboard (Quickstart -> .env.local -> "Show secret" -> "Copy Snippet")
# en zet je 'm in je eigen .env.local (die staat al in .gitignore).
DATABASE_URL=

# Admin-login voor /admin (offerteoverzicht)
# Verzin een eigen, sterke ADMIN_SESSION_SECRET (een willekeurige lange string) — dit
# ondertekent de login-sessie en mag nooit gedeeld worden.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GoHighLevel (stuurt offerte/contact/dealer-aanvragen door naar een GHL-workflow)
# De URL van een GHL-workflow met trigger "Inbound Webhook". Zonder deze var worden
# aanvragen simpelweg niet doorgestuurd; de formulieren blijven wel gewoon werken.
GHL_WEBHOOK_URL=
